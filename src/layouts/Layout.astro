---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'LILA | Your agent. Your Machine. Your data.' } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <!-- Cloudflare Web Analytics -->
    <script type='module' src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "15a62dd2b2dd4a058ecf05f666ab6f70"}'></script>
    <!-- End Cloudflare Web Analytics -->
  </body>
</html>

<style is:global>
  :root {
    --bg: #fafaf9;
    --fg: #1c1917;
    --muted: #57534e;
    --surface: #ffffff;
    --border: #e7e5e4;
    --accent: #7c3aed;
    --accent-fg: #ffffff;
    --radius: 12px;
    --max-width: 1100px;
    color-scheme: light dark;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0c0a09;
      --fg: #f5f5f4;
      --muted: #a8a29e;
      --surface: #1c1917;
      --border: #292524;
      --accent: #a78bfa;
      --accent-fg: #0c0a09;
    }
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    line-height: 1.6;
  }

  .container {
    width: 100%;
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: 1.5rem;
  }
</style>
